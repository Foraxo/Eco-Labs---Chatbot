rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidChatSession(data) {
      return data.id is string && data.id.size() <= 128
        && data.authorName is string && data.authorName.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.modelUsed is string && data.modelUsed.size() <= 64;
    }

    function isValidChatLog(data) {
      return data.id is string && data.id.size() <= 128
        && data.sessionId is string && data.sessionId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 100
        && data.query is string && data.query.size() <= 20000
        && data.reply is string && data.reply.size() <= 50000
        && data.model is string && data.model.size() <= 64
        && data.timestamp is string && data.timestamp.size() <= 64;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document rule
    match /test/{docId} {
      allow read, write: if true;
    }

    // Chat Sessions Collection - shared among team members with password access
    match /chatSessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if true;
      allow create: if isValidId(sessionId) && isValidChatSession(request.resource.data);
      allow update: if isValidId(sessionId) && isValidChatSession(request.resource.data);
      allow delete: if isValidId(sessionId);
    }

    // Individual Chat Logs Collection
    match /chatLogs/{logId} {
      allow get: if isValidId(logId);
      allow list: if true;
      allow create: if isValidId(logId) && isValidChatLog(request.resource.data);
      allow update: if isValidId(logId) && isValidChatLog(request.resource.data);
      allow delete: if isValidId(logId);
    }
  }
}
